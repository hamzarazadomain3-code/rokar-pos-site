{
  "name": "rokar-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Rokar POS — marketing site for small retail shop owners in Pakistan.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify:content": "node build/verify-content.mjs",
    "verify:ssr": "node build/verify-ssr.mjs",
    "verify:bundle": "node build/verify-bundle.mjs",
    "verify:fonts": "node build/verify-fonts.mjs",
    "verify:claims": "node build/verify-claims.mjs",
    "verify": "npm run typecheck && npm run verify:content && npm run verify:claims && npm run verify:ssr && npm run verify:fonts && npm run build && npm run verify:bundle",
    "fonts": "python build/build_fonts.py",
    "og:cover": "python build/build-og-cover.py"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "framer-motion": "^12.0.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
