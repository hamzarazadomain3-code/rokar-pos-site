node_modules/
dist/
*.err.log
*.log
tsconfig.tsbuildinfo
.DS_Store
.vercel

# Upstream font downloads for build/build_fonts.py. The subset in
# public/fonts/ is what ships and is committed; the ~1.2 MB of original
# Google woff2 files it is cut from is re-downloaded on demand.
.gfonts-cache/
.gfonts.css
__pycache__/
*.pyc

# Secrets. The sibling pos-app keeps GH_TOKEN in a .env, and this repo has no
# .env of its own yet -- which is exactly why the rule was missing. Nothing in
# here should ever be committed, so any .env shape is ignored rather than just
# the one name someone happened to use. .env.example stays tracked on purpose.
.env
.env.*
!.env.example
